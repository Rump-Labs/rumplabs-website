RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Optional: fallback USD to INR rate if the market-rate feed is down (defaults to 96)
USD_TO_INR_RATE=96

# Optional: SheerID hosted verification configuration (only needed for student discount feature)
# Leave these unset if you don't want to use SheerID - the student discount option will be hidden
NEXT_PUBLIC_SHEERID_PROGRAM_ID=your_sheerid_program_id
NEXT_PUBLIC_SHEERID_ORIGIN=https://services.sandbox.sheerid.com

# Supabase Configuration
SUPABASE_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_KEY=your_supabase_anon_key

